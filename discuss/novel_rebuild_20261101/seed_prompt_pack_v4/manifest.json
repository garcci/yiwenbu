      "file": "A_morning.prompt.txt",
      "prompt_characters": 1277,
      "spoken_characters": 326,
      "spoken_cjk": 285,
      "source_rows": [
        {
          "scene": 2,
          "role": "旁白",
          "text": "许绾的未婚夫陆长生去交租，一夜没回。邻居沈砚却送回了他的烟管。"
        },
        {
          "scene": 2,
          "role": "沈砚",
          "text": "我去北闸看炭船，见他搭陈老七五更的班船走了。船起了篙，烟管落在跳板上。"
        },
        {
          "scene": 2,
          "role": "许绾",
          "text": "三十块租钱，我们一人十五。我这份攒了半年。"
        },
        {
          "scene": 2,
          "role": "许绾",
          "text": "出门前，他还替我绑紧了缸盖。"
        },
        {
          "scene": 2,
          "role": "沈砚",
          "text": "还有十块押金，是他私下问我借的，借据还在我铁盒里。他这一走，我这钱找谁要？"
        },
        {
          "scene": 3,
          "role": "沈砚",
          "text": "天冷，你一个女人家守着空铺子不便宜。这几天先别开门接活了，债主和房东找来，我替你挡着。"
        },
        {
          "scene": 3,
          "role": "许绾",
          "text": "不用。万祥布庄的林掌柜今早还要送生坯来，这门关不得。"
        },
        {
          "scene": 3,
          "role": "沈砚",
          "text": "我也是替你想。"
        },
        {
          "scene": 4,
          "role": "周管事",
          "text": "许姑娘，陈东家的收讫红单呢？后街孙掌柜愿多出五块顶头费，现银现结。没红单，今儿就把钥匙退给我！"
        },
        {
          "scene": 4,
          "role": "许绾",
          "text": "周管事，草约写得明白，留足三日宽限，到后天日落才满期。没到后天日落，您不能转铺子。"
        },
        {
          "scene": 4,
          "role": "周管事",
          "text": "行！到后天日落既没红单也没现钱，交更我立刻换锁！"
        }
      ],
      "sha256": "ab9fc152ca32e22decb64e2cd8b30f56ee0abb952641b17878102dd6c3253a97"
    },
    {
      "id": "B_inquiry",
      "scenes": [
        5,
        6
      ],
      "file": "B_inquiry.prompt.txt",
      "prompt_characters": 1056,
      "spoken_characters": 191,
      "spoken_cjk": 171,
      "source_rows": [
        {
          "scene": 5,
          "role": "旁白",
          "text": "镇上向来南边运炭、北边走客。沈砚一个打铁的，清早去北闸看哪门子的炭船？"
        },
        {
          "scene": 5,
          "role": "许绾",
          "text": "七叔，五更天的时候，长生搭您的船出闸没有？"
        },
        {
          "scene": 5,
          "role": "陈老七",
          "text": "搭我的船？昨夜三更闸槽卡了烂木头，封闸清淤到现在！我这船打昨晚就没动过窝，客人们天亮前全退钱走旱路了！"
        },
        {
          "scene": 6,
          "role": "许绾",
          "text": "赵叔，烦您去德清陈宅账房问一句：陆长生昨日午后可曾交过铺租，收讫红单开给他没有。"
        },
        {
          "scene": 6,
          "role": "老赵",
          "text": "北闸封了船，来回全靠走纤道。我送完沿途的包裹再去陈府问话，最快也得明儿黄昏才能给你回信。"
        }
      ],
      "sha256": "bb4c11f2ad0c6804d956b9d2748973bf068e9601e6a90eb10697172f18972c7a"
    },
    {
      "id": "C_order",
      "scenes": [
        7,
        8,
        9
      ],
      "file": "C_order.prompt.txt",
      "prompt_characters": 1081,
      "spoken_characters": 231,
      "spoken_cjk": 201,
      "source_rows": [
        {
          "scene": 7,
          "role": "林掌柜",
          "text": "阿绾，刚过桥听人说长生搭船走了？这二十匹寿帐绸子娇贵，你一个人，后天还能按时做出来吗？"
        },
        {
          "scene": 7,
          "role": "许绾",
          "text": "街上那是误传。手艺在我身上，后天午后您只管来验第一道水色。"
        },
        {
          "scene": 8,
          "role": "陆长生",
          "text": "阿绾，手往里收一寸，看准门槛再转！"
        },
        {
          "scene": 8,
          "role": "许绾",
          "text": "知道了，就你罗唆！"
        },
        {
          "scene": 9,
          "role": "许绾",
          "text": "林掌柜，请留步！刚才我是怕您撤单才说大话。长生眼下联系不上，这绸子浸了水沉，我一个人抬不动满竿。"
        },
        {
          "scene": 9,
          "role": "林掌柜",
          "text": "我就知道你在硬撑。现在叫伙计搬回去？"
        },
        {
          "scene": 9,
          "role": "许绾",
          "text": "今明两日我先备好料。后天派个熟手来帮我抬竿、看半日桶，工钱从我染资扣。午后您照常验色。"
        },
        {
          "scene": 9,
          "role": "林掌柜",
          "text": "成，后天一早阿四来。午后我来验色，工钱照半日算。"
        }
      ],
      "sha256": "cebd51c2c94f662785a6c82b20872089186c7d065a38995eac8ee2baf60402bc"
    },
    {
      "id": "D_night",
