        {
          "scene": 11,
          "role": "陆长生",
          "text": "大娘，松手……别撕了纸！"
        },
        {
          "scene": 12,
          "role": "许绾",
          "text": "长生？……你在哪儿？"
        },
        {
          "scene": 12,
          "role": "沈砚",
          "text": "借据还在我铁盒里。"
        },
        {
          "scene": 12,
          "role": "许绾",
          "text": "明早，去沈家看借据。"
        }
      ],
