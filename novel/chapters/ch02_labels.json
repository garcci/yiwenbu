[
 {
  "t": "你开门了？",
  "kind": "say",
  "para_end": true,
  "who": "laozhou",
  "tone": "whisper"
 },
 {
  "t": "老周手里的粥碗停在嘴边，半天没往下送。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "slow"
 },
 {
  "t": "天刚亮，沈砚找到更房的时候，老周正蹲在炭盆边上喝粥。他六十来岁，背驼得厉害，身上那件褐色棉袄打了好几块补丁，梆子和灯笼就挂在墙上。听沈砚说完昨夜的事，他把碗放下了，放得很轻，像怕惊着谁。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "开了。",
  "kind": "say",
  "who": "laozhou",
  "tone": "whisper"
 },
 {
  "t": "沈砚说，",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "门外没人，只有一盏灯笼。",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "灯笼呢？",
  "kind": "say",
  "para_end": true,
  "who": "laozhou",
  "tone": "normal"
 },
 {
  "t": "在我屋里。",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "老周的脸色变了变，压低了声音：",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "沈书吏，你听我一句，回去就把它扔了，扔远点，扔到河里去。",
  "kind": "say",
  "para_end": true,
  "who": "laozhou",
  "tone": "whisper"
 },
 {
  "t": "为什么？",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "老周不说话，拿筷子在粥里搅，搅了半天，才说：",
  "kind": "narr",
  "who": "narrator",
  "tone": "slow"
 },
 {
  "t": "借火的，不是一回两回了。",
  "kind": "say",
  "para_end": true,
  "who": "laozhou",
  "tone": "whisper"
 },
 {
  "t": "沈砚在他对面坐下来：",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "您说说。",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "老周叹了口气。他说，这事从他年轻时候就有。每到下大雪的夜里，城北那一片，总有人家半夜听见敲门，三下，然后一句“借个火”。老辈人都知道，不能开，也不能应声。开了门，门口就留一盏灭了的灯笼；应了声，那家里过不了年就要出事。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "slow"
 },
 {
  "t": "出什么事？",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "有的丢东西，有的丢人。",
  "kind": "say",
  "who": "laozhou",
  "tone": "whisper"
 },
 {
  "t": "老周把声音压得更低，",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "东街卖豆腐的刘二，十几年前应过一声，开春就不见了，到现在没找着。",
  "kind": "say",
  "para_end": true,
  "who": "laozhou",
  "tone": "whisper"
 },
 {
  "t": "沈砚想了想：",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "借火的事，是城北多，还是哪儿都有？",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "城北多。",
  "kind": "say",
  "para_end": true,
  "who": "laozhou",
  "tone": "normal"
 },
 {
  "t": "县衙后院也算城北？",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "老周愣了一下，点点头：",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "算，衙门背后那条街，再往北就是城墙了。",
  "kind": "say",
  "para_end": true,
  "who": "laozhou",
  "tone": "normal"
 },
 {
  "t": "陆先生那年，也遇见过？",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "老周的手抖了一下，粥洒出来一点，落在炭盆里，嗤的一声。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal",
  "sfx": "sting"
 },
 {
  "t": "“陆先生……”他看了沈砚一眼，",
  "kind": "narr",
  "who": "narrator",
  "tone": "slow"
 },
 {
  "t": "他开了门。开了门还不算，他还追出去了。",
  "kind": "say",
  "para_end": true,
  "who": "laozhou",
  "tone": "whisper"
 },
 {
  "t": "然后呢？",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "然后过了没几天，他就出城去黑水渡办差，再也没回来。",
  "kind": "say",
  "who": "laozhou",
  "tone": "whisper"
 },
 {
  "t": "老周把碗往旁边一推，站起来摘梆子，",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "沈书吏，我得去睡了。你是读书人，你不信这些，我知道。可陆先生也是读书人。",
  "kind": "say",
  "para_end": true,
  "who": "laozhou",
  "tone": "whisper"
 },
 {
  "t": "",
  "pause": 1.6,
  "tone": "normal"
 },
 {
  "t": "沈砚从更房出来，没回县衙，提着那盏灯笼往东街走。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "他想知道灯笼里烧的是什么油。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "slow"
 },
 {
  "t": "东街拐角有一家药铺，门脸不大，匾上写着“苏记”。铺子刚卸下门板，柜台后面站着一个姑娘，十六七岁，穿一身靛蓝的粗布衣裳，头发用一根红绳扎着，正踮着脚往高处的药斗里放东西。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "抓药？",
  "kind": "say",
  "who": "suwan",
  "tone": "normal"
 },
 {
  "t": "她头也不回。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "问点事。",
  "kind": "say",
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "沈砚把灯笼放在柜台上，",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "劳驾，你帮我闻闻，这里面烧的是什么油。",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "姑娘转过身，看了看灯笼，又看了看他：",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "你是衙门新来的那个录异吏？",
  "kind": "say",
  "para_end": true,
  "who": "suwan",
  "tone": "normal"
 },
 {
  "t": "沈砚一怔：",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "你怎么知道？",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "县里谁不知道。录异房空了三年，昨天门房到处说，来了个不要命的小书吏。",
  "kind": "say",
  "who": "suwan",
  "tone": "normal"
 },
 {
  "t": "她说着，已经把灯笼拿过去，拔出里面那截蜡烛，凑到鼻子底下。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "她闻了一下，眉头就皱起来了。又闻了一下，伸出指甲在烛芯底下刮了一点油渣，放在舌尖上碰了碰，马上吐掉了。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "slow"
 },
 {
  "t": "苦的。",
  "kind": "say",
  "who": "suwan",
  "tone": "normal"
 },
 {
  "t": "她说，",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "这不是蜡，是羊油掺了别的东西。你闻这个涩味，是熬过卤水的锅熬出来的。卤水你知道吧，熬盐剩下的那个。",
  "kind": "say",
  "para_end": true,
  "who": "suwan",
  "tone": "normal"
 },
 {
  "t": "熬盐？",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "对。",
  "kind": "say",
  "who": "suwan",
  "tone": "normal"
 },
 {
  "t": "姑娘把蜡烛放回去，",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "锅熬过卤水，再熬油，油里就有这股苦涩味，洗都洗不掉。我奶奶说过，这种油只有一种人用。",
  "kind": "say",
  "para_end": true,
  "who": "suwan",
  "tone": "slow"
 },
 {
  "t": "什么人？",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "姑娘看了看铺子门口，没有接着往下说，只说了一句：",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "你自己猜。",
  "kind": "say",
  "para_end": true,
  "who": "suwan",
  "tone": "normal"
 },
 {
  "t": "沈砚没有猜。私盐是杀头的买卖，这话谁也不会在大白天的铺子里说出口。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "slow"
 },
 {
  "t": "多谢。",
  "kind": "say",
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "他拱拱手，",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "姑娘怎么称呼？",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "苏晚。",
  "kind": "say",
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "她又转回去够药斗，",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "沈书吏，你今晚还守着？",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "守。",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "带上我。",
  "kind": "say",
  "para_end": true,
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "沈砚以为自己听错了。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "苏晚回过头，很认真地说：",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "我想闻闻，那个借火的人身上，是什么味儿。",
  "kind": "say",
  "para_end": true,
  "who": "suwan",
  "tone": "normal"
 },
 {
  "t": "",
  "pause": 1.6,
  "tone": "normal"
 },
 {
  "t": "那天夜里又下了雪。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "县令听说录异房的事，只说了一句“你看着办”，就再没过问。沈砚和苏晚在录异房里坐到二更，屋里没点灯，只有炭盆里一点暗红的光。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "苏晚裹着一件旧棉斗篷，坐在门边的小凳上，耳朵贴着门板。沈砚坐在桌边，手里攥着录异簿，簿子翻在陆先生那一页上。他一遍一遍看那行没写完的字，看那道撕痕。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "撕了几页？",
  "kind": "say",
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "苏晚小声问。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "七页。",
  "kind": "say",
  "para_end": true,
  "who": "suwan",
  "tone": "normal"
 },
 {
  "t": "谁撕的？",
  "kind": "say",
  "para_end": true,
  "who": "suwan",
  "tone": "normal"
 },
 {
  "t": "不知道。",
  "kind": "say",
  "para_end": true,
  "who": "suwan",
  "tone": "normal"
 },
 {
  "t": "二更的梆子响过，老周的声音隔着几道院墙传过来：",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "天寒地冻，小心火烛——",
  "kind": "say",
  "who": "laozhou",
  "tone": "normal"
 },
 {
  "t": "声音拖得很长，慢慢远了。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "然后就没声音了。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "雪落着。炭盆里的炭塌了一块，轻轻一响。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "苏晚忽然抬起手，示意他别动。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "沈砚屏住气，什么也没听见。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "不在这儿。",
  "kind": "say",
  "who": "shenyan",
  "tone": "normal"
 },
 {
  "t": "苏晚用口型说，伸手指了指西边。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "两人轻轻拔开门闩，从门缝里往外看。院子里白茫茫一片，雪地上没有新脚印。可是西角的方向，井架子下面，雪地上亮着一点光。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "是一盏灯笼，放在井沿上。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "沈砚提着没点的油灯就要出去，苏晚一把拉住他，鼻子在冷风里抽了抽，低声说：",
  "kind": "narr",
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "是那个油的味儿。",
  "kind": "say",
  "para_end": true,
  "who": "suwan",
  "tone": "normal"
 },
 {
  "t": "他们踩着雪，一步一步挪过去。离井还有十几步的时候，那盏灯笼里的光一跳，灭了。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "没有风。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "沈砚站住了。苏晚的手攥着他的袖子，攥得很紧。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "井边上空无一人。灯笼端端正正地放在井沿的冰上，跟昨夜他门口那一盏一模一样。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "沈砚走过去，蹲下来，伸手去摸。竹柄是温的。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "他正要把灯笼提起来，井里传出了声音。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "笃——笃——笃——",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "是什么东西敲在石头上，声音拖得很长，一下，一下，又一下。停了片刻。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "笃，笃。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "两声短的，又急又轻。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "三长，两短。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "苏晚的手一下子松开了。沈砚跪在井沿上，往黑洞洞的井口里看，什么也看不见。他张嘴想喊一声，又硬生生忍住了。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "老周的话在他耳朵边上：不能开门，也不能应声。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
 },
 {
  "t": "井里安静了很久。然后，又是三长两短。",
  "kind": "narr",
  "para_end": true,
  "who": "narrator",
  "tone": "normal"
